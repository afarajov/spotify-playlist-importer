# Public Spotify Client ID from the developer dashboard. Not a secret.
# Never put a Spotify client secret or an AI API key in frontend environment files.
VITE_SPOTIFY_CLIENT_ID=

# Must exactly match a redirect URI registered for the Spotify app.
# Spotify does not accept localhost. Use the loopback IP for local development.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Optional base URL for the future backend that will host AI parsing.
VITE_API_BASE_URL=
